# Copy to .env (git-ignored) and fill in.

# LLM: "local" (LM Studio on port 1234, default) or "anthropic" (Claude)
LLM_PROVIDER="local"
ANTHROPIC_API_KEY=""
# Optional, defaults to Claude Haiku 5.5
# ANTHROPIC_MODEL="claude-haiku-5-5"

# TTS: "kokoro" (local, default) or "cartesia"
TTS_PROVIDER="kokoro"
CARTESIA_API_KEY=""
CARTESIA_VOICE_ID=""
# Optional, defaults to sonic-3
# CARTESIA_MODEL="sonic-3"

OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
RIME_API_KEY=""
